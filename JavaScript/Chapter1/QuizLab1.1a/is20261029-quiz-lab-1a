<!DOCTYPE html>
<html>
<head>
    <title>PageTurner Bookstore - Daily Sales</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { color: #2c3e50; }
        .sales-info { background: #f8f9fa; padding: 15px; border-radius: 5px; }
    </style>
</head>
<body>
    <h1>PageTurner Bookstore</h1>
    <div class="sales-info">
        <h2>Daily Sales Calculator</h2>
        <p>Today's book sales will be calculated automatically.</p>
        <p>Check the console (F12) to see the results!</p>
    </div>
    
    <h3>Store Hours</h3>
    <p>Monday - Friday: 9:00 AM - 8:00 PM</p>
    <p>Saturday - Sunday: 10:00 AM - 6:00 PM</p>
    
    <!-- INSTRUCTION: Add your JavaScript here, right before the closing </body> tag -->
    <script>
    
    
    let morningSales = 150;
    let afternoonSales = 200;
    
    
    let totalSales = morningSales + afternoonSales;
    
    
    console.log("PageTurner Daily Sales Report: ");
    console.log("Morning sales: $" + morningSales);
    console.log("Afternoon sales: $" + afternoonSales);
    console.log("Total daily sales: $" + totalSales);
    
    
    </script>
    
</body>
</html>